print("Введите расстояние (км):")
a = float(input())
r = a / 100
print("Введите скорость (км/ч):")
v = float(input())
print("Введите расход топлива (л/100 км):")
g = float(input())
print(f"Маршрут: {a} км, скорость {v} км/ч")
print(f"Время в пути: {float(a/v):.2f} часов")
print(f"Расход топлива: {g} л/100 км")
print(f"Общий расход: {g*r:.2f} литров")
